# Copy to .env. Without it everything runs on the demo base, without a model and without Telegram.

COMPANY=Пекарня «Колосок»
# KB_DIR=/app/knowledge/kolosok        # a folder of .md files, "## " sections become fragments

# ============ Model ============
# none: the answer is the found fragment itself (free, nothing leaves the server)
# gigachat: GigaChat API. The freemium for individuals is for personal non-commercial use only,
#   a client's consultant needs a paid package or a company contract (scope GIGACHAT_API_CORP/B2B)
# openai: any OpenAI-compatible API (OpenRouter, Groq, YandexGPT, a local Ollama)
LLM_PROVIDER=none
GIGACHAT_AUTH_KEY=                   # "Authorization key" from developers.sber.ru
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_CA_BUNDLE=                # the Russian Trusted CA, certs/russian_trusted_ca.pem by default
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# ============ Limits ============
MESSAGES_PER_DAY=10                  # questions per visitor (IP or Telegram id) a day
DAILY_TOKEN_BUDGET=200000            # then the model is off and answers come from fragments
LLM_CONCURRENCY=1                    # GigaChat gives individuals one stream
QUEUE_MAX=20
QUOTA_SALT=change-me                 # visitor ids are stored as salted hashes

# ============ Telegram ============
TELEGRAM_BOT_TOKEN=                  # the consultant bot, @BotFather
MANAGER_BOT_TOKEN=                   # who sends leads, the same bot by default
MANAGER_CHAT_ID=                     # where leads go, your id from @userinfobot
TELEGRAM_PROXY=                      # if api.telegram.org is blocked from the server

ALLOWED_ORIGINS=*                    # sites allowed to embed the widget, comma separated
DEMO_LEADS=                          # 1 for a public demo: leads are shown, not saved or sent
